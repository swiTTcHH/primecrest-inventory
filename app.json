{
  "expo": {
    "name": "PrimeCrest Inventory",
    "slug": "primecrest-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo.png",
    "scheme": "primecrestmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/Logo.png",
      "bundleIdentifier": "com.switch0019.primeCrestMobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Logo.png",
        "backgroundImage": "./assets/images/Logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.switch0019.primeCrestMobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#013b61",
          "android": {
            "image": "./assets/images/Logo.png",
            "imageWidth": 100
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID."
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c4081d94-b0c8-46c2-b2cd-4ae429415a64"
      }
    },
    "owner": "switch0019"
  }
}
